rules_version = '2';

// 간직.log — 여행 데이터는 그 여행의 멤버(N인)에게만. 초대코드로만 합류.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function tripMembers(tripId) {
      return get(/databases/$(database)/documents/trips/$(tripId)).data.memberIds;
    }
    function isMemberOf(tripId) {
      return signedIn()
        && exists(/databases/$(database)/documents/trips/$(tripId))
        && request.auth.uid in tripMembers(tripId);
    }

    // users/{uid}: 본인만 쓰고, 로그인 사용자는 읽는다(멤버 이름 표시용).
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // trips: 멤버만 읽는다. 생성은 자신을 유일 멤버+owner로. 합류는 자신을
    // memberIds에 추가하는 갱신(N인, 상한 없음). 삭제는 owner만.
    match /trips/{tripId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.memberIds.hasOnly([request.auth.uid])
        && request.resource.data.ownerId == request.auth.uid;
      allow update: if isMemberOf(tripId)
        || (signedIn()
            && !(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds);
      allow delete: if signedIn() && request.auth.uid == resource.data.ownerId;
    }

    // 여행 소유 컬렉션: 그 여행 멤버만 읽고 쓴다. tripId 문서 필드로 스코프.
    match /places/{id} {
      allow read, delete: if isMemberOf(resource.data.tripId);
      allow create: if isMemberOf(request.resource.data.tripId);
      allow update: if isMemberOf(resource.data.tripId)
        && isMemberOf(request.resource.data.tripId);
    }
    match /memories/{id} {
      allow read, delete: if isMemberOf(resource.data.tripId);
      allow create: if isMemberOf(request.resource.data.tripId);
      allow update: if isMemberOf(resource.data.tripId);
    }
    match /notifications/{id} {
      allow read, update: if isMemberOf(resource.data.tripId);
      allow create: if isMemberOf(request.resource.data.tripId);
      allow delete: if false;
    }
  }
}
