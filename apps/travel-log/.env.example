# ─────────────────────────────────────────────────────────────
# 간직.log 환경변수
# 이 파일을 `.env.local`로 복사하고 값을 채우면 실제 Firebase/Kakao에 연결됩니다.
# 값이 비어 있으면 앱은 자동으로 "로컬 데모 모드"(localStorage + 가짜 로그인)로
# 동작하므로 키 없이도 전체 흐름을 볼 수 있습니다.
# ─────────────────────────────────────────────────────────────

# Firebase (Google Login / Firestore / Storage)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM 웹푸시 VAPID 공개키 (M4 · 여행 알림)
# Firebase 콘솔 → 프로젝트 설정 → 클라우드 메시징 → 웹 푸시 인증서 → 키 쌍
# 비어 있으면 알림 옵트인은 "설정 필요"로 비활성 (인앱 알림은 계속 동작)
VITE_FIREBASE_VAPID_KEY=

# Kakao Maps JavaScript 키 (지도·장소 검색)
# https://developers.kakao.com → 내 애플리케이션 → JavaScript 키
VITE_KAKAO_MAP_KEY=
