# ─────────────────────────────────────────────────────────────
# 간직.log 환경변수
# 이 파일을 `.env.local`로 복사하고 값을 채우면 실제 Firebase/Google Maps에 연결됩니다.
# 값이 비어 있으면 앱은 자동으로 "로컬 데모 모드"(localStorage + 가짜 로그인)로
# 동작하므로 키 없이도 전체 흐름을 볼 수 있습니다.
# ─────────────────────────────────────────────────────────────

# Firebase (Google Login / Firestore / Storage)
# 간직.log는 기존 date.log 프로젝트(date-log-b1e52)를 전용한다 — 아래 6개 값은
# 그 프로젝트의 웹 앱 구성(Firebase 콘솔 → 프로젝트 설정 → 내 앱)에서 그대로 가져온다.
# 구글 캘린더 내보내기(설정 화면)를 쓰려면 이 프로젝트의 GCP에서
# "Google Calendar API" 사용 설정 + OAuth 동의화면에 .../auth/calendar.events 스코프 등록.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# FCM 웹푸시 VAPID 공개키 (M4 · 여행 알림)
# Firebase 콘솔 → 프로젝트 설정 → 클라우드 메시징 → 웹 푸시 인증서 → 키 쌍
# 비어 있으면 알림 옵트인은 "설정 필요"로 비활성 (인앱 알림은 계속 동작)
VITE_FIREBASE_VAPID_KEY=

# Google Maps JavaScript 키 (지도·장소 검색, Places API New)
# https://console.cloud.google.com → API 및 서비스 → 사용 설정: "Maps JavaScript API" + "Places API (New)"
#   → 사용자 인증 정보 → API 키 (billing 계정 필요). HTTP 리퍼러로 도메인 제한 권장.
VITE_GOOGLE_MAPS_KEY=
