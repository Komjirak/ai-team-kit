rules_version = '2';

// 여행 사진(대표사진·회고)은 그 여행 폴더에만. 로그인 사용자가 이미지 업로드.
service firebase.storage {
  match /b/{bucket}/o {
    match /trips/{tripId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024          // ≤10MB/장
        && request.resource.contentType.matches('image/.*');  // 이미지만
    }
  }
}
