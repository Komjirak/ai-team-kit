rules_version = '2';

// 추억 사진은 커플 폴더에만. 로그인 사용자가 자기 커플 경로에 업로드.
service firebase.storage {
  match /b/{bucket}/o {
    match /couples/{coupleId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024          // ≤10MB/장
        && request.resource.contentType.matches('image/.*');  // 이미지만
    }
  }
}
