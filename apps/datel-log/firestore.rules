rules_version = '2';

// Datel.log — 커플 데이터는 커플 멤버에게만. 초대코드로만 결합.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }
    function isMemberOf(coupleId) {
      return signedIn()
        && exists(/databases/$(database)/documents/couples/$(coupleId))
        && request.auth.uid in get(/databases/$(database)/documents/couples/$(coupleId)).data.memberIds;
    }

    // users/{uid}: 본인만 읽고 쓴다. coupleId는 본인이 설정.
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    // couples: 멤버만 읽는다. 생성은 로그인 사용자(자신을 첫 멤버로).
    // 합류는 memberIds 배열에 자신을 추가하는 업데이트만 허용(≤2명).
    match /couples/{coupleId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.memberIds.hasOnly([request.auth.uid]);
      allow update: if isMemberOf(coupleId)
        || (signedIn()
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.size() <= 2);
      allow delete: if false;
    }

    // 커플 소유 컬렉션: 멤버만 읽고 쓴다. coupleId는 문서 필드로 스코프.
    match /places/{id} {
      allow read, delete: if isMemberOf(resource.data.coupleId);
      allow create: if isMemberOf(request.resource.data.coupleId);
      allow update: if isMemberOf(resource.data.coupleId)
        && isMemberOf(request.resource.data.coupleId);
    }
    match /courses/{id} {
      allow read, delete: if isMemberOf(resource.data.coupleId);
      allow create: if isMemberOf(request.resource.data.coupleId);
      allow update: if isMemberOf(resource.data.coupleId);
    }
    match /memories/{id} {
      allow read, delete: if isMemberOf(resource.data.coupleId);
      allow create: if isMemberOf(request.resource.data.coupleId);
      allow update: if isMemberOf(resource.data.coupleId);
    }
    match /notifications/{id} {
      allow read, update: if isMemberOf(resource.data.coupleId);
      allow create: if isMemberOf(request.resource.data.coupleId);
      allow delete: if false;
    }
  }
}
